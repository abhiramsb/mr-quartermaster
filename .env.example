# required
DISCORD_TOKEN=

# optional: instant command sync to one server while testing (leave empty in production)
DEV_GUILD_ID=

# optional: where settings are stored (default: quartermaster.db in the working folder)
DB_PATH=quartermaster.db

# optional: user IDs of the other MRFC bots (Developer Mode -> right-click the bot -> Copy User ID).
# /setup gives each one access to its own channel: GroundsKeeper -> #mrfc-sessions,
# Coach -> #mrfc-tactics, Scout -> #mrfc-scouting. The bots must already be in the server.
GROUNDSKEEPER_BOT_ID=
COACH_BOT_ID=
SCOUT_BOT_ID=
